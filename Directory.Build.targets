<Project>

  <!--
    Directory.Build.targets
    Aplica-se a TODOS os projetos da solution.

    PRE-BUILD: dotnet format (IDE0005 + IDE0055 + IDE0065)

    Por padrao NAO roda em todo build local.
    E ativado por:
      [a] dotnet build -p:RunDotnetFormat=true
      [b] Automaticamente quando CI=true (GitHub Actions)
          ou TF_BUILD=True (Azure Pipelines)

    Modo LOCAL  = fix, corrige os arquivos.
    Modo CI     = verify, falha o build se houver diff.

    Ver CODING_STANDARDS.md para os comandos manuais.
  -->

  <PropertyGroup>
    <_IsCI Condition="'$(CI)' == 'true' or '$(TF_BUILD)' == 'True'">true</_IsCI>
    <RunDotnetFormat Condition="'$(RunDotnetFormat)' == '' and '$(_IsCI)' == 'true'">true</RunDotnetFormat>
    <RunDotnetFormat Condition="'$(RunDotnetFormat)' == ''">false</RunDotnetFormat>
    <DotnetFormatExtraFlags Condition="'$(_IsCI)' == 'true'">--verify-no-changes</DotnetFormatExtraFlags>
    <DotnetFormatExtraFlags Condition="'$(_IsCI)' != 'true'"></DotnetFormatExtraFlags>
    <_FormatSentinel>$(MSBuildThisFileDirectory)obj\_dotnet_format.sentinel</_FormatSentinel>
  </PropertyGroup>

  <Target Name="DotnetFormatPreBuild"
          BeforeTargets="PreBuildEvent;Build"
          Condition="'$(RunDotnetFormat)' == 'true' and !Exists('$(_FormatSentinel)')">

    <Message Importance="High"
             Text="[pre-build] Executando dotnet format..." />

    <Exec Command="dotnet format &quot;$(MSBuildThisFileDirectory)SmartDigitalPsicoAPI.sln&quot; --diagnostics IDE0005 IDE0055 IDE0065 --severity info $(DotnetFormatExtraFlags)"
          WorkingDirectory="$(MSBuildThisFileDirectory)"
          IgnoreExitCode="false" />

    <Touch Files="$(_FormatSentinel)" AlwaysCreate="true" />

    <Message Importance="High" Text="[pre-build] dotnet format concluido." />
  </Target>

  <Target Name="DotnetFormatResetSentinel"
          AfterTargets="Build"
          Condition="'$(RunDotnetFormat)' == 'true' and Exists('$(_FormatSentinel)')">
    <Delete Files="$(_FormatSentinel)" />
  </Target>

</Project>
