{
  "ConnectionStrings": {
    "SmartDigitalPsicoDBConnectionSQLServer": "",
    "SmartDigitalPsicoDBConnectionMySQL": ""
  },
  "TokenConfigurations": {
    "Audience": "ExempleAudience",
    "Issuer": "ExempleIssuer",
    "Secret": "",
    "Minutes": 60,
    "DaysToExpiry": 7
  },
  "StorageServices": {
    "AzureStorage": {
      "ConnectionString": "",
      "DaysExpiresBlobSas": 3
    }
  },
  "APP_ENVIRONMENT": "",
  "DataBaseConfigurations": {
    "TypeDataBase": 1
  },
  "AppSettings": {
    "MyKeySettings": "MY_VALUE_OF_MyKeySettings",
    "ResourcesTemp": "C:/home/SmartDigitalPsicoWebAPI/ResourcesTemp",
    "AllowedFileExtensions": [ "jpg", "jpeg", "png", "gif", "bmp", "doc", "docx", "xls", "xlsx", "pdf" ],
    "AllowedContentTypes": [ "image/jpeg", "image/png", "image/gif", "image/bmp", "application/msword", "application/vnd.openxmlformats-officedocument.wordprocessingml.document", "application/vnd.ms-excel", "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet", "application/pdf" ],
    "MaxFileSizeMegabytes": 100
  },
  "SecuritySettings": {
    "AesSettings": {
      "AesKey": "",
      "AesIv": ""
    } 
  },
  "SmtpSettings": {
    "Server": "",
    "Port": 587,
    "SenderName": "",
    "SenderEmail": "",
    "Username": "",
    "Password": ""
  },
  "AuthConfiguration": {
    "IsEnable": true,
    "TypeApiCredential": 0
  },
  "CacheConfiguration": {
    "IsEnable": true,
    "TypeCache": 1,
    "AbsoluteExpirationInHours": 1,
    "AbsoluteExpirationInMinutes": 1,
    "SlidingExpirationInMinutes": 3,
    "PathCache": "C:/home/SmartDigitalPsicoWebAPI/ResourcesTempCache",
    "ExtensionCache": ".json"
  },
  "ResiliencePolicyConfig": {
    "PolicyName": "CustomRetryPolicy",
    "RetryCount": 4,
    "RetryDelayInSeconds": 2
  },
  "LocationSaveFileConfigurationVO": {
    "TypeLocationSaveFiles": 0
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "DbStringLocalizer": {
    "ConnectionString": ""
  },
  "LocalizationSettings": {
    "UseTypeFullNames": true,
    "UseOnlyPropertyNames": false,
    "TranslateHandling": "UseValue",
    "PreventCultureFallback": false,
    "DesignCulture": {
      "Culture": "en-US",
      "IsDefault": true
    },
    "SupportedCultures": [
      {
        "Culture": "pt-BR",
        "IsDefault": false
      },
      {
        "Culture": "fr-FR",
        "IsDefault": false
      }
    ],
    "UseSqlServer": true,
    "ConnectionString": ""
  },
  "AllowedHosts": "*",
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Sinks.File"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "System": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] {TraceId} {SourceContext} {Message:lj}{NewLine}{Exception}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/SmartDigitalPsicoWebAPI_.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 14,
          "shared": true,
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] {TraceId} {SourceContext} {Message:lj}{NewLine}{Exception}"
        }
      }
    ],
    "Enrich": [ "FromLogContext" ],
    "Properties": {
      "Application": "SmartDigitalPsico.WebAPI"
    }
  }
}